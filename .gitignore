# --- TapeForge .gitignore -------------------------------------------------
# Documentation policy (README.rst): all Markdown and all planning documents
# stay out of Git. Public documentation lives in README.rst; shared results
# are .json / .csv / .rst.

# All Markdown, including agent-internal Markdown instructions, stays local.
*.md
*.markdown
*.mdx

# Plans, PRDs, design notes and private working documents stay local.
planning/
.planning/
plans/
docs/planning/
docs/plans/
*_PRD.*
*.prd
*.plan

# Local agent skill instructions; regenerated by tools/bootstrap_commit_skill.py.
.agents/

# Private local commit tooling; never tracked.
/tools/bootstrap_commit_skill.py
/tools/commit_policy.toml
/tools/commit_safe.py
/tools/commit_skill_template.txt

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.python-version

# Test / type / coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Datasets: downloaded market data archives are never committed (licence and size).
data/
*.zip
*.csv.gz
*.parquet
*.feather

# Exception: the committed test fixtures. They are 5-row excerpts, not
# datasets, and a fresh clone cannot run the ingest tests without them.
!tests/fixtures/
!tests/fixtures/**

# Baseline and policy run records written by tapeforge.execution.runner.write_run_record.
runs/

# Profiler and trace artifacts
*.nsys-rep
*.sqlite
*.qdrep
*.json.gz
traces/
profiles/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

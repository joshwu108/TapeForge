# --- TapeForge .gitignore -------------------------------------------------
# Policy source: PRD section 12.3. All Markdown and all planning documents
# stay out of Git. Public docs live in README.rst; shared results are
# .json / .csv / .rst.

# Keep all Markdown and agent-internal Markdown instructions local
*.md
*.markdown
*.mdx

# Keep plans, PRDs, design notes and private working documents local
planning/
.planning/
plans/
docs/planning/
docs/plans/
*_PRD.*
*.prd
*.plan

# Local agent skill instructions (regenerated by tools/bootstrap_commit_skill.py)
.agents/

# Private local commit tooling
/tools/bootstrap_commit_skill.py
/tools/commit_policy.toml
/tools/commit_safe.py
/tools/commit_skill_template.txt

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.python-version

# Test / type / coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Datasets: never commit downloaded market data archives (PRD section 10)
data/
*.zip
*.csv.gz
*.parquet
*.feather

# Exception: the tiny committed test fixtures. They are 5-row excerpts, not
# datasets, and a fresh clone cannot run the ingest tests without them.
!tests/fixtures/
!tests/fixtures/**

# Profiler and trace artifacts
*.nsys-rep
*.sqlite
*.qdrep
*.json.gz
traces/
profiles/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
